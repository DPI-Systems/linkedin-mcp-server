# --- LinkedIn MCP (dpi-linkedin-mcp) ------------------------------------
# Va ANTES del comodin *.dev.dpi-systems.com.
#
# Quien llega aqui maneja la cuenta de LinkedIn de Fernando, asi que hay dos
# barreras: solo direcciones de la mesh NetBird y un token Bearer
# (/opt/dpi/services/.secrets/LINKEDIN_MCP_TOKEN, exportado por el
# entrypoint del compose como LINKEDIN_MCP_TOKEN).
#
# El servidor rechaza un Host que no conoce (proteccion contra DNS
# rebinding), por eso se le reescribe a localhost.
linkedin-mcp.dev.dpi-systems.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    @fuera_de_la_mesh not remote_ip 100.81.0.0/16
    respond @fuera_de_la_mesh "Solo desde la mesh" 403

    @sin_token not header Authorization "Bearer {env.LINKEDIN_MCP_TOKEN}"
    respond @sin_token "Falta el token" 401

    reverse_proxy dpi-linkedin-mcp:8000 {
        header_up Host localhost:8000
        header_up -Origin
        # Respuestas en streaming (SSE): sin buffer y sin cortar llamadas largas.
        flush_interval -1
        transport http {
            read_timeout 30m
        }
    }
}
